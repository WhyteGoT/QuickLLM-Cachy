# =============================================================================
# QuickLLM Sandbox - configurazione dell'host
# =============================================================================
# Copia questo file in `config.env` e adattalo alla macchina.
# `config.env` e' ignorato da git: e' l'UNICO posto dove mettere IP, hostname
# e segreti di questa macchina specifica.
#
#   cp config.example.env config.env
#
# Ogni valore qui sotto ha un default sensato: se lasci una riga commentata il
# worker se la calcola da solo. Scommenta solo cio' che vuoi forzare.
# Le variabili passate da systemd hanno sempre la precedenza su questo file.
# =============================================================================

# -----------------------------------------------------------------------------
# API del worker
# -----------------------------------------------------------------------------
# Interfaccia su cui ascolta l'API. 0.0.0.0 = raggiungibile da LAN e Tailscale.
# ATTENZIONE: l'API non ha autenticazione. Se non ti serve l'accesso da LAN usa
# 127.0.0.1 e raggiungila via Tailscale (vedi docs/INFRASTRUCTURE.md).
#SANDBOX_HOST=0.0.0.0
#SANDBOX_PORT=8765

# IP LAN di questa macchina, usato per costruire gli indirizzi mostrati al
# client. Se lo lasci vuoto viene rilevato dalla rotta di default.
#SANDBOX_LAN_HOST=192.168.1.2

# -----------------------------------------------------------------------------
# Console VM (QEMU -> VNC -> websockify -> noVNC)
# -----------------------------------------------------------------------------
#VNC_DISPLAY=1
#NOVNC_HOST=0.0.0.0
#NOVNC_PORT=6080
# Forza la cartella web di noVNC. Vuoto = prima il submodule ./novnc, poi i
# percorsi di sistema (/usr/share/novnc, /usr/share/webapps/novnc, ...).
#NOVNC_WEB_DIR=

# Firmware UEFI per le VM Windows 11. Vuoto = autodetect per distro.
# Arch/CachyOS: /usr/share/edk2/x64/OVMF_CODE.4m.fd
# Debian/Ubuntu: /usr/share/OVMF/OVMF_CODE_4M.fd
# Fedora:        /usr/share/edk2/ovmf/OVMF_CODE.fd
#OVMF_CODE_PATH=
#OVMF_VARS_PATH=

# -----------------------------------------------------------------------------
# Risorse delle VM
# -----------------------------------------------------------------------------
#VM_MEMORY_MB=4096
#VM_VCPUS=4
#VM_DISK_SIZE=40G
#VM_DISK_SIZE_WIN11=60G
#VM_MEMORY_MB_WIN98=512
# RAM che il worker lascia sempre all'host quando riporta la capacita'.
#HOST_RESERVE_MB=4096
# Quanti workload contemporanei (VM o Minecraft). Di default 1: una macchina
# desktop non regge una VM e un server Minecraft insieme.
#MAX_RUNNING_WORKLOADS=1

# -----------------------------------------------------------------------------
# Minecraft
# -----------------------------------------------------------------------------
#MINECRAFT_LOCAL_PORT=25565
#MINECRAFT_MEMORY_MB=4096
#MINECRAFT_VCPUS=4
# Indirizzo pubblico annunciato ai giocatori. Vuoto = nome MagicDNS di
# Tailscale rilevato in automatico, altrimenti l'IP LAN.
#MINECRAFT_PUBLIC_HOST=
#MINECRAFT_PUBLIC_PORT=10000

# Limite di upload per mondi, plugin e mod (MB).
#MAX_UPLOAD_MB=512

# =============================================================================
# Servizi companion (usati solo da install.sh, non dal worker)
# =============================================================================

# --- ComfyUI ---------------------------------------------------------------
# Cartella dell'installazione ComfyUI e python del suo venv.
COMFYUI_DIR=/home/emanuel/StabilityMatrix/Packages/ComfyUI
COMFYUI_PYTHON=/home/emanuel/StabilityMatrix/Packages/ComfyUI/venv/bin/python
COMFYUI_ARGS=--listen 0.0.0.0 --lowvram
COMFYUI_PORT=8188

# --- LM Studio -------------------------------------------------------------
# LM Studio e' un'app GUI: gira sotto Xvfb tramite bin/lmstudio-headless-watchdog.
LMSTUDIO_BIN=/usr/bin/lm-studio
LMSTUDIO_CLI_DIR=/home/emanuel/.lmstudio/bin
LMS_SERVER_HOST=0.0.0.0
LMSTUDIO_PORT=1234

# --- Beszel (monitoraggio) -------------------------------------------------
# SEGRETI: questo file non deve mai finire su git.
# Prendi KEY e TOKEN dall'hub Beszel quando aggiungi il sistema.
BESZEL_AGENT_BIN=/opt/beszel-agent/beszel-agent
BESZEL_PORT=45876
BESZEL_HUB_URL=http://192.168.1.87:8090
BESZEL_KEY=
BESZEL_TOKEN=
